# Copy these into .env.local and your host's environment settings.

# Long random values, at least 32 characters each, e.g. `openssl rand -hex 32`.
# Without them, the /vendor page and the reminder job reject every request.
VENDOR_SECRET=
CRON_SECRET=

# Who gets the reminders
VENDOR_EMAIL=
BILLING_CUSTOMER_EMAIL=

# Sending email through Resend. EMAIL_FROM must use a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: your site's address, used for the link in your emails, e.g. https://pos.example.com
APP_URL=
# Optional: shown on the "Service paused" page, e.g. your name and phone number
SUPPORT_CONTACT=

# The NEW database, server-side only. Never prefix these with NEXT_PUBLIC_.
# Until both are set, subscription status is kept in a local file (.data/), for development only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Development only: log emails to the console instead of sending them.
# EMAIL_DRY_RUN=1

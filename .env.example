# Copy these into .env.local and your host's environment settings.

# The Supabase project (Project Settings > API). The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The same project URL, and the secret key. Server-side only: never prefix these with NEXT_PUBLIC_.
# Without them, staff accounts can't be managed and subscription status is kept in a
# local file (.data/), which is for development only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random values, at least 32 characters each, e.g. `openssl rand -hex 32`.
# Without them, the /vendor page and the reminder job reject every request.
VENDOR_SECRET=
CRON_SECRET=

# Who gets the reminders
VENDOR_EMAIL=
BILLING_CUSTOMER_EMAIL=

# Sending email through Resend. EMAIL_FROM must use a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Your site's address, used for the link in your emails, e.g. https://pos.example.com
APP_URL=
# Shown on the "Service paused" page, e.g. your name and phone number
SUPPORT_CONTACT=

# Development only: log emails to the console instead of sending them.
# EMAIL_DRY_RUN=1
